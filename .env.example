ADDR=:8080
DB_PATH=./korus.db
MEDIA_ROOT=./media
JWT_SECRET=changeme
TOKEN_TTL=24h
REFRESH_TTL=720h
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
RATE_LIMIT_AUTH_COUNT=10
RATE_LIMIT_AUTH_WINDOW=1m
SCAN_WATCH=false
SCAN_WORKERS=8
SCAN_EXCLUDE_PATTERN=
SCAN_EMBEDDED_COVER=true
SCAN_AUTO_PLAYLISTS=true
ENABLE_MUSICBRAINZ=false
MUSICBRAINZ_AGENT=Korus/0.1 (https://github.com/Aunali321/korus)
ENABLE_LISTENBRAINZ=false
LISTENBRAINZ_TOKEN=
LISTENBRAINZ_USER=
ADMIN_USER=admin
ADMIN_PASSWORD=changeme
ADMIN_EMAIL=admin@example.com
AI_ENABLED=false
# API key for the AI provider. AI_API_KEY takes precedence; OPENROUTER_API_KEY kept for back-compat.
AI_API_KEY=
OPENROUTER_API_KEY=
# Provider + base URL default to OpenRouter. Override to use any OpenAI-compatible provider.
# e.g. OpenCode Go: AI_PROVIDER=opencode  AI_BASE_URL=https://opencode.ai/zen/go/v1  AI_MODEL=kimi-k2.6  AI_REASONING=off
AI_PROVIDER=openrouter
AI_BASE_URL=
AI_MODEL=arcee-ai/trinity-large-thinking:arcee-ai
AI_REASONING=medium
RADIO_DEFAULT_LIMIT=20
METADATA_ENRICH_ENABLED=true
METADATA_ENRICH_URL=https://metadata.aun.rest
